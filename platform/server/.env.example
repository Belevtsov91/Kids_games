HOST=0.0.0.0
PORT=3000
# Адрес сайта. Несколько — через запятую (прод, www, превью Vercel). Изменяющие запросы с других адресов — 403.
CORS_ORIGIN=http://localhost:5173
# Сколько прокси перед сервером: Vercel (rewrite /api) → Render = 2. В проде по умолчанию 2, локально выключено.
# Без этого все посетители видны с адреса прокси и делят один rate-limit.
# TRUST_PROXY=2
LOG_LEVEL=info
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# GAMES_DIR= папка с играми, по умолчанию games/ в корне репозитория
# 32 байта hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=
# В проде (HTTPS) обязательно true.
COOKIE_SECURE=false
# Адрес сайта: из него строится ссылка в письме «Восстановить пароль». По умолчанию CORS_ORIGIN.
APP_URL=http://localhost:5173
# Почта через Brevo (письмо восстановления пароля). Ключи — только в .env, в git их не кладём.
# Вариант 1, SMTP: Brevo → SMTP & API → SMTP. Логин вида xxxx@smtp-brevo.com, пароль — SMTP-ключ (xsmtpsib-…).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Вариант 2, HTTP API: Brevo → SMTP & API → API Keys (xkeysib-…). Если задан, используется вместо SMTP.
BREVO_API_KEY=
# Отправитель должен быть подтверждён в Brevo (Senders & IP).
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Interact Games
# Секрет для задач по расписанию: POST /api/jobs/hourly (отчёт за неделю) и /api/jobs/daily (чистка БД)
# с заголовком x-cron-secret. Нужен, если сервер засыпает (бесплатный Render). Пусто — маршрутов нет.
CRON_SECRET=
