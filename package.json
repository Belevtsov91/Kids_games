{
  "name": "interact-games",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @ig/shell --filter @ig/server dev",
    "dev:shell": "corepack pnpm --filter @ig/shell dev",
    "dev:server": "corepack pnpm --filter @ig/server dev",
    "build": "corepack pnpm lint && corepack pnpm -r typecheck && corepack pnpm --filter @ig/shell build",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "test:e2e": "corepack pnpm --filter @ig/shell test:e2e",
    "lint": "node tools/check-boundaries.mjs && node tools/check-file-size.mjs",
    "new-game": "node tools/create-game.mjs",
    "db:sql": "node tools/db-sql.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
